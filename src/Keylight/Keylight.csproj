<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Keylight</RootNamespace>
    <AssemblyName>Keylight</AssemblyName>
    <PackageId>Keylight</PackageId>
    <Version>0.1.0</Version>
    <Authors>Keylight</Authors>
    <Description>Offline-first software licensing for .NET, Godot, and Unity — signed Ed25519 leases, device activations, entitlements.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://keylight.dev</PackageProjectUrl>
    <RepositoryUrl>https://github.com/keylight-dev/keylight-csharp</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>
</Project>
